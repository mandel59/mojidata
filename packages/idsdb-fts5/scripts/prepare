#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

STAMP=".idsdb-fts5.input.sha256"
FTS_VERSION="5"

if [ -n "${MOJIDATA_IDSDB_RECIPE:-}" ]; then
  rm -f "$STAMP"
  echo "idsdb-fts5 prepare: building from IDSFlow recipe"
  MOJIDATA_IDSDB_FTS_VERSION="$FTS_VERSION" \
  MOJIDATA_IDSDB_OUT_DIR="$PWD" \
    yarn --cwd ../idsdb exec node --import tsx prepare.ts
  exit 0
fi

CURRENT_HASH="$(
  MOJIDATA_IDSDB_FTS_VERSION="$FTS_VERSION" \
    python3 ../idsdb/scripts/input-hash.py
)"

if [ -f idsfind.db ] && [ -f idsdecompose.db ] && [ -f "$STAMP" ]; then
  PREV_HASH="$(cat "$STAMP")"
  if [ "$CURRENT_HASH" = "$PREV_HASH" ]; then
    echo "idsdb-fts5 prepare (fts${FTS_VERSION}): inputs unchanged, skipping rebuild"
    exit 0
  fi
fi

rm -f "$STAMP"
echo "idsdb-fts5 prepare (fts${FTS_VERSION}): inputs changed (or first build), rebuilding"
OUT_DIR="$PWD"
if command -v cygpath >/dev/null 2>&1; then
  OUT_DIR="$(cygpath -w "$PWD")"
fi
if [ -f ../idsdb/scripts/derive-index ] && bash ../idsdb/scripts/derive-index fts5 "$OUT_DIR"; then
  echo "idsdb-fts5 prepare: reused FTS4 decomposition"
else
  MOJIDATA_IDSDB_FTS_VERSION="$FTS_VERSION" \
  MOJIDATA_IDSDB_OUT_DIR="$OUT_DIR" \
    yarn --cwd ../idsdb exec node --import tsx prepare.ts
fi
FINAL_HASH="$(
  MOJIDATA_IDSDB_FTS_VERSION="$FTS_VERSION" \
    python3 ../idsdb/scripts/input-hash.py
)"
echo "$FINAL_HASH" > "$STAMP"
