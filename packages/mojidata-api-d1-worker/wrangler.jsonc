{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mojidata-api-d1",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "MOJIDATA_API_DEPLOYMENT": "default"
  },
  "d1_databases": [
    {
      "binding": "MOJIDATA_DB",
      "database_name": "mojidata-api-d1-mojidata-staging-u18-20260917",
      "database_id": "6f957b62-6475-46fd-bfec-8f49238478d8"
    },
    {
      "binding": "IDSFIND_DB",
      "database_name": "mojidata-api-d1-idsfind-staging-u18-20260917",
      "database_id": "095c69ab-48be-4323-8fb1-a00af7ed931c"
    }
  ],
  "env": {
    "staging": {
      "name": "mojidata-api-d1-staging",
      "vars": {
        "MOJIDATA_API_DEPLOYMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "MOJIDATA_DB",
          "database_name": "mojidata-api-d1-mojidata-staging-u18-20260917",
          "database_id": "6f957b62-6475-46fd-bfec-8f49238478d8"
        },
        {
          "binding": "IDSFIND_DB",
          "database_name": "mojidata-api-d1-idsfind-staging-u18-20260917",
          "database_id": "095c69ab-48be-4323-8fb1-a00af7ed931c"
        }
      ]
    },
    "production": {
      "name": "mojidata-api-d1-production",
      "vars": {
        "MOJIDATA_API_DEPLOYMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "MOJIDATA_DB",
          "database_name": "mojidata-api-d1-production-mojidata",
          "database_id": "00000000-0000-0000-0000-000000000201"
        },
        {
          "binding": "IDSFIND_DB",
          "database_name": "mojidata-api-d1-production-idsfind",
          "database_id": "00000000-0000-0000-0000-000000000202"
        }
      ]
    }
  }
}
