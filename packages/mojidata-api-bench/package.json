{
  "name": "@mandel59/mojidata-api-bench",
  "private": true,
  "version": "0.0.0",
  "description": "Internal benchmark tooling for mojidata-api backends",
  "scripts": {
    "bench": "node --import tsx ./benchmarks/run.ts",
    "bench:analyze-idsfind-patterns": "node --import tsx ./benchmarks/analyze-idsfind-patterns.ts",
    "bench:audit-idsfind-idsgrep": "node --import tsx ./benchmarks/audit-idsfind-idsgrep.ts",
    "bench:compare": "node --import tsx ./benchmarks/compare.ts",
    "bench:build-idsfind-structural": "node --import tsx ./benchmarks/build-idsfind-structural-fts.ts",
    "bench:derive-idsfind-equality-holdout": "node --import tsx ./benchmarks/derive-idsfind-equality-holdout.ts",
    "bench:derive-idsfind-page-layout": "node --import tsx ./benchmarks/derive-idsfind-page-layout.ts",
    "bench:derive-idsfind-whole-literal": "node --import tsx ./benchmarks/derive-idsfind-whole-literal.ts",
    "bench:idsfind-indexes": "node --import tsx ./benchmarks/idsfind-indexes.ts",
    "bench:idsgrep-eids": "node --import tsx ./benchmarks/compare-idsgrep-eids.ts",
    "bench:validate-idsfind-equality-holdout": "node --import tsx ./benchmarks/validate-idsfind-equality-holdout.ts",
    "bench:local": "node --import tsx ./benchmarks/local.ts",
    "bench:remote": "node --import tsx ./benchmarks/remote.ts",
    "bench:prepare": "yarn run prepare:test-deps && yarn prepare",
    "prepare:test-deps": "yarn --cwd ../.. workspace @mandel59/mojidata run prepare && yarn --cwd ../.. workspace @mandel59/idsdb run prepare && yarn --cwd ../.. workspace @mandel59/idsdb-fts5 run prepare && yarn --cwd ../.. workspace @mandel59/idsdb-bvec run prepare && yarn --cwd ../.. workspace @mandel59/mojidata-api-core run prepare && yarn --cwd ../.. workspace @mandel59/mojidata-api-hono run prepare && yarn --cwd ../.. workspace @mandel59/mojidata-api-runtime run prepare && yarn --cwd ../.. workspace @mandel59/mojidata-api-sqljs run prepare && yarn --cwd ../.. workspace @mandel59/mojidata-api-better-sqlite3 run prepare && yarn --cwd ../.. workspace @mandel59/mojidata-api-node-sqlite run prepare",
    "prepare": "tsc --noEmit",
    "bench:differential-idsfind-equality": "node --import tsx ./benchmarks/differential-idsfind-equality.ts",
    "bench:differential-idsflow-query-plan": "node --import tsx ./benchmarks/differential-idsflow-query-plan.ts",
    "bench:differential-idsflow-overlay": "node --import tsx ./benchmarks/differential-idsflow-overlay.ts",
    "bench:differential-idsflow-resolution": "node --import tsx ./benchmarks/differential-idsflow-resolution.ts",
    "bench:differential-idsflow-exact-audit": "node --import tsx ./benchmarks/differential-idsflow-exact-audit.ts",
    "bench:differential-idsflow-fts-candidates": "node --import tsx ./benchmarks/differential-idsflow-fts-candidates.ts"
  },
  "dependencies": {
    "@mandel59/idsdb-bvec": "workspace:^",
    "@mandel59/idsdb-fts5": "^1.9.0",
    "@mandel59/mojidata-api-better-sqlite3": "^1.9.0",
    "@mandel59/mojidata-api-core": "^1.9.0",
    "@mandel59/mojidata-api-node-sqlite": "^1.9.0",
    "@mandel59/mojidata-api-sqljs": "^1.8.1"
  },
  "devDependencies": {
    "@mandel59/idsdb-utils": "workspace:^",
    "@mandel59/idsflow-eids": "workspace:^",
    "@types/better-sqlite3": "^5.4.1",
    "@types/node": "^24.10.4",
    "better-sqlite3": "^12.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
