#!/bin/bash
# prune: remove unused cache files from cache/.sha256sum
set -eu
cd "$(dirname "$0")/.."
fgrep -v \
    -f <(find cache -type l -exec readlink {} \; | while IFS= read -r target; do basename "$target"; done) \
    <(find cache/.sha256sum -type f -exec basename {} \;) \
    | while IFS= read -r cachefile; do
        rm "cache/.sha256sum/$cachefile"
    done
