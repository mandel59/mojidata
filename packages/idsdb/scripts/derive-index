#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
MODE="$1"
OUT_DIR="$2"
# Recipes bypass reuse. Other transformation options remain in the input hash.
[ -z "${MOJIDATA_IDSDB_RECIPE:-}" ] || exit 1
[ -z "${MOJIDATA_IDSDB_INDEX_MODE:-}" ] || [ "$MOJIDATA_IDSDB_INDEX_MODE" = "$MODE" ] || exit 1
[ -f idsfind.db ] && [ -f idsdecompose.db ] && [ -f .idsdb.input.sha256 ] || exit 1
BASE_HASH="$(env -u MOJIDATA_IDSDB_INDEX_MODE MOJIDATA_IDSDB_FTS_VERSION=4 python3 scripts/input-hash.py)"
[ "$BASE_HASH" = "$(cat .idsdb.input.sha256)" ] || exit 1
BASE_DIR="$PWD"
if command -v cygpath >/dev/null 2>&1; then
  OUT_DIR="$(cygpath -w "$OUT_DIR")"
  BASE_DIR="$(cygpath -w "$BASE_DIR")"
fi
node --import tsx build-index-derived.ts "$BASE_DIR" "$OUT_DIR" "$MODE"
